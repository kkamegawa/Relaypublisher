<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.3.3" />
    <!-- Used only to build bzip2 fixtures (BZip2OutputStream) for XarPkgBundleInspectorTests; production
         code never compresses bzip2, only decompresses it via Bzip2DecompressionStream (issue #127). -->
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IntuneLobPublisher.Core\IntuneLobPublisher.Core.csproj" />
    <ProjectReference Include="..\..\src\IntuneLobPublisher.Cli\IntuneLobPublisher.Cli.csproj" />
  </ItemGroup>

</Project>
